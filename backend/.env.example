# Copy to .env; never commit the real .env or expose it to the frontend.
DATABASE_URL=sqlite:///./test.db
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Required only when bootstrapping an empty database (username: admin), >=12 chars.
INITIAL_ADMIN_PASSWORD=
# Remote Linux accounts only; snapshot at startup, does not reset existing accounts.
# Use quotes to preserve # and special characters; use a private value in production.
ACCOUNT_INITIAL_PASSWORD='Qwe123!@#'
# Enable only after configuring SSH authentication/known_hosts; it modifies remote accounts!
SYNC_ENABLED=false
# With sync enabled, provision personal gateway keys; private keys stay on gateways.
GATEWAY_KEY_SYNC_ENABLED=true
# Optional known_hosts file; defaults to AsyncSSH/OpenSSH known_hosts behavior.
SSH_KNOWN_HOSTS=
# Unsafe compatibility escape hatch; prefer verified known_hosts instead.
SSH_INSECURE_SKIP_HOST_KEY_CHECK=false

# OpenAI-compatible Chat Completions. Base URL includes /v1, NOT /chat/completions.
# No AI requests occur until a logged-in user sends a question.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=45
